    "format": "json",
    "syntax": "plain",
    "template": "{\"keys\":[ PASTE THE PUBLIC JWK HERE ]}",
    "output": "json",
    "x": 400,
    "y": 100,
    "wires": [["jose_ex4_httpout"]]
  },
